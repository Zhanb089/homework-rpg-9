@startuml Visitor Pattern - Chronomancer's Vault
skinparam classAttributeIconSize 0
skinparam classFontSize 13
hide circle
title Homework 9 — Visitor Pattern (Artifact Appraisal)

interface ArtifactVisitor {
  +visit(weapon: Weapon): void
  +visit(potion: Potion): void
  +visit(scroll: Scroll): void
  +visit(ring: Ring): void
  +visit(armor: Armor): void
}

abstract class Artifact {
  -name: String
  -value: int
  -weight: int
  --
  +getName(): String
  +getValue(): int
  +getWeight(): int
  +{abstract} accept(visitor: ArtifactVisitor): void
}

class Weapon {
  -attackBonus: int
  --
  +getAttackBonus(): int
  +accept(visitor): void
}

class Potion {
  -healing: int
  --
  +getHealing(): int
  +accept(visitor): void
}

class Scroll {
  -spellName: String
  --
  +getSpellName(): String
  +accept(visitor): void
}

class Ring {
  -magicBonus: int
  --
  +getMagicBonus(): int
  +accept(visitor): void
}

class Armor {
  -defenseBonus: int
  --
  +getDefenseBonus(): int
  +accept(visitor): void
}

class Inventory {
  -artifacts: List<Artifact>
  --
  +addArtifact(a: Artifact): void
  +getArtifacts(): List<Artifact>
  +size(): int
  +accept(visitor: ArtifactVisitor): void
  +copy(): Inventory
}

class GoldAppraiser {
  -totalGold: int
  --
  +getTotalGold(): int
  +visit(weapon): void
  +visit(potion): void
  +visit(scroll): void
  +visit(ring): void
  +visit(armor): void
}

class EnchantmentScanner {
  -magicalCount: int
  --
  +getMagicalCount(): int
  +visit(weapon): void
  +visit(potion): void
  +visit(scroll): void
  +visit(ring): void
  +visit(armor): void
}

class CurseDetector {
  -cursedCount: int
  --
  +getCursedCount(): int
  +visit(weapon): void
  +visit(potion): void
  +visit(scroll): void
  +visit(ring): void
  +visit(armor): void
}

class WeightCalculator <<open/closed proof>> {
  -totalWeight: int
  --
  +getTotalWeight(): int
  +visit(weapon): void
  +visit(potion): void
  +visit(scroll): void
  +visit(ring): void
  +visit(armor): void
}

Weapon --|> Artifact
Potion --|> Artifact
Scroll --|> Artifact
Ring   --|> Artifact
Armor  --|> Artifact

Inventory "1" o-- "*" Artifact : holds
Inventory ..> ArtifactVisitor : walks all artifacts

GoldAppraiser       ..|> ArtifactVisitor
EnchantmentScanner  ..|> ArtifactVisitor
CurseDetector       ..|> ArtifactVisitor
WeightCalculator    ..|> ArtifactVisitor

Artifact ..> ArtifactVisitor : accept(this)\ndouble dispatch

note bottom of Inventory
  accept(visitor) is the only place
  visitor.visit(...) is called.
  Adding new visitors does not
  modify any artifact class.
end note

@enduml